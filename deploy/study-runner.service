[Unit]
Description=Black Gold lightweight C++ judge (Bubblewrap, no Docker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=judge
Group=judge
WorkingDirectory=/opt/billiards-club
EnvironmentFile=/etc/billiards-study.env
ExecStart=/usr/bin/node /opt/billiards-club/study-runner.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp
ProtectHome=read-only
UMask=0077
# 沙箱为worker直接启动的子进程，继承该私有/tmp；不依赖外部守护进程。
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryAccounting=true
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
CPUQuota=75%
CPUWeight=20
Nice=10
KillMode=control-group
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target

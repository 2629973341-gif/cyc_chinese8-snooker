[Unit]
Description=Black Gold Game Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/billiards-club
ExecStart=/usr/bin/node /opt/billiards-club/server.js
Environment=NODE_ENV=production
Environment=PORT=80
Restart=always
RestartSec=3

# 允许非 root 进程绑定 80 端口。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
